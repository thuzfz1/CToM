@@ -104,6 +104,74 @@ use_torch_compile: true
 # KL loss coefficient when use_kl_loss is enabled. For GRPO
 kl_loss_coef: 0.001
 
+# CToM: weight (lambda) of the auxiliary "predict-next-user-turn" SFT loss added
+# jointly with the PPO loss in the actor update. 0 disables the feature.
+pred_sft_coef: 0.0
+
+# CToM: schedule for pred_sft_coef, as fractions of total training steps:
+# linear ramp 0 -> pred_sft_coef over [0, warmup_frac), hold, then linear decay
+# to pred_sft_coef_final over [decay_start_frac, 1]. A negative final value
+# disables the schedule (constant pred_sft_coef), which is the default.
+pred_sft_coef_final: -1.0
+pred_sft_coef_warmup_frac: 0.0
+pred_sft_coef_decay_start_frac: 1.0
+
+# CToM: in the joint PPO + aux-SFT step, measure each term's gradient on its own
+# (park the PPO grad, back the aux term alone, sum them back) so the update logs
+# actor/grad_norm_pg, actor/grad_norm_aux and actor/grad_cos_aux_pg. The parameter
+# update is unchanged; costs two extra grad-norm all-reduces and one clone of the
+# trainable grads per mini-batch. Ignored when pred_sft_coef == 0.
+pred_sft_grad_diag: true
+
+# CToM: ceiling on the auxiliary SFT gradient, as a MULTIPLE of the policy-gradient
+# norm. After both terms are measured separately the aux gradient is rescaled in
+# place so ||g_aux|| <= pred_sft_grad_ratio_cap * ||g_pg||, then the two are summed.
+# 0 disables the cap (historical behaviour). Unlike a small fixed pred_sft_coef this
+# HOLDS the ratio as the SFT loss decays. Implies pred_sft_grad_diag.
+# Measured at coef 0.1 (run 904892 vs 908998): uncapped ||g_aux||/||g_pg|| is 17-25x
+# at step 1 and still 3-4x at step 180, i.e. the SFT term owns the update direction.
+pred_sft_grad_ratio_cap: 0.5
+
+# CToM: drop aux-loss supervision slots whose target is only the user
+# simulator's termination signal (~30% of expert-only prediction targets).
+pred_sft_skip_terminate: true
+
+# CToM sft_v3: independently bounded answer and prediction generation phases.
+pred_answer_max_tokens: 768
+pred_prediction_max_tokens: 192
+
+# CToM sft_v4: bound on the revision phase (the visible answer). In sft_v4
+# pred_answer_max_tokens bounds the internal draft instead.
+pred_revision_max_tokens: 768
+
+# CToM sft_v6 (BDR, the retired BDR predecessor): phase caps for the draft (0 ->
+# pred_answer_max_tokens), belief and ask phases; max internal REVISE turns per
+# user round; counterfactual self-revision samples per replied turn (VOI gate).
+bdr_draft_max_tokens: 0
+bdr_belief_max_tokens: 256
+bdr_ask_max_tokens: 512
+bdr_max_internal_revisions: 1
+bdr_cf_samples: 2
+
+# CToM sft_v7 (the paper's method section): think / ask caps, prediction-gated
+# inner-revision cap per round, verdict source. Draft cap = bdr_draft_max_tokens
+# (0 -> pred_answer_max_tokens); prediction cap = pred_prediction_max_tokens.
+v7_think_max_tokens: 256
+v7_ask_max_tokens: 512
+v7_max_inner_revisions: 3
+v7_verdict_mode: parse
+v7_action_protocol: legacy
+decision_entropy_coef: 0.0
+
+# CToM sft_v3: include the prediction phase in the PPO loss (response_mask=1).
+# False keeps the historical behaviour (prediction masked out of policy gradient).
+pred_in_ppo: false
+
+# Detached prediction NLL reward credited to the answer policy.
+pred_nll_reward_coef: 0.0
+pred_nll_reward_transform: neg_nll
+pred_nll_max: 20.0
+
 # Type of KL divergence loss. Options: "kl"(k1), "abs", "mse"(k2), "low_var_kl"(k3), "full"
 kl_loss_type: low_var_kl
 
