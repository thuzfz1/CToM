+        # the row builder needs no mode-specific branch. Only the boundary the
+        # credit lands on differs, and that arrives via turn_end_indices.
+        if self._ctom_prediction_mode() not in ("sft_v3", "sft_v4", "sft_v5", "sft_v7") or coef == 0.0:
+            return dense, {}
+
+        from ctom.prediction_loss import (
+            build_prediction_sft_v3_rows,
+            prediction_log_probs_to_reward,
+        )
+
+        msgs_col = batch.non_tensor_batch.get("messages", None)
+        contexts_col = batch.non_tensor_batch.get("prediction_context_ids", None)
+        validity_col = batch.non_tensor_batch.get("phase_validity", None)
+        boundaries_col = batch.non_tensor_batch.get("turn_end_indices", None)
+        tef_col = batch.non_tensor_batch.get("tool_extra_fields", None)
+
+        def _extra(i, key, direct, default):
+            if direct is not None:
+                return direct[i]
+            if tef_col is not None:
+                return tef_col[i].get(key, default)
+            return default
+
+        scorer_rows = []
+        row_map = []
+        candidate_turns = 0
+        invalid_turns = 0
+        max_len = int(self.config.actor_rollout_ref.rollout.max_model_len)
+        for batch_index in range(len(batch)):
+            holder = _extra(batch_index, "messages", msgs_col, {})
+            conv = holder.get("messages", []) if isinstance(holder, dict) else (holder or [])
+            if len(conv) == 1 and isinstance(conv[0], list):
+                conv = conv[0]
+            raw_contexts = _extra(
+                batch_index, "prediction_context_ids", contexts_col, []
+            )
+            raw_validities = _extra(
+                batch_index, "phase_validity", validity_col, []
+            )
+            raw_boundaries = _extra(
+                batch_index, "turn_end_indices", boundaries_col, []
+            )
+            contexts = [] if raw_contexts is None else list(raw_contexts)
+            validities = [] if raw_validities is None else list(raw_validities)
+            boundaries = [] if raw_boundaries is None else list(raw_boundaries)
+            if not conv or not contexts:
+                continue
+            rows = build_prediction_sft_v3_rows(
+                contexts, conv, self.tokenizer, max_len=max_len
+            )
+            for row in rows:
+                candidate_turns += 1
+                turn = int(row["turn_index"])
+                validity = validities[turn] if turn < len(validities) else {}
+                boundary = boundaries[turn] if turn < len(boundaries) else None
+                if not (
+                    validity.get("answer_valid", False)
+                    and validity.get("prediction_valid", False)
+                ):
+                    invalid_turns += 1
+                    continue
+                if boundary is None or not (0 <= int(boundary) < dense.shape[1]):
+                    continue
+                scorer_rows.append(row)
+                row_map.append((batch_index, turn, int(boundary)))
+
+        if not scorer_rows:
+            return dense, {
+                "reward/pred_nll_scored_turns": 0.0,
+                "reward/pred_nll_mean": 0.0,
+                "reward/pred_nll_candidate_turns": float(candidate_turns),
+                "reward/pred_nll_invalid_turns": float(invalid_turns),
+            }
+
+        pad_id = self.tokenizer.pad_token_id
+        if pad_id is None:
+            pad_id = self.tokenizer.eos_token_id or 0
+        contexts = [row["input_ids"][: row["target_start"]] for row in scorer_rows]
+        targets = [row["input_ids"][row["target_start"] :] for row in scorer_rows]
+        max_prompt = max(len(ids) for ids in contexts)
+        max_response = max(len(ids) for ids in targets)
+
+        prompts, responses, attention_masks, position_ids, response_masks = (
+            [], [], [], [], []
+        )
+        for context_ids, target_ids in zip(contexts, targets, strict=True):
+            prompt_pad = max_prompt - len(context_ids)
+            response_pad = max_response - len(target_ids)
+            prompt = [pad_id] * prompt_pad + context_ids
+            response = target_ids + [pad_id] * response_pad
+            attention = (
+                [0] * prompt_pad
+                + [1] * len(context_ids)
+                + [1] * len(target_ids)
+                + [0] * response_pad
+            )
+            positions = torch.tensor(attention).cumsum(0).sub(1).clamp_min(0).tolist()
+            prompts.append(prompt)
+            responses.append(response)
+            attention_masks.append(attention)
+            position_ids.append(positions)
+            response_masks.append([1] * len(target_ids) + [0] * response_pad)
+
+        score_batch = DataProto.from_single_dict(
+            {
+                "prompts": torch.tensor(prompts, dtype=torch.long),
+                "responses": torch.tensor(responses, dtype=torch.long),
+                "input_ids": torch.tensor(
+                    [p + r for p, r in zip(prompts, responses, strict=True)], dtype=torch.long
+                ),
+                "attention_mask": torch.tensor(attention_masks, dtype=torch.long),
+                "position_ids": torch.tensor(position_ids, dtype=torch.long),
+                "response_mask": torch.tensor(response_masks, dtype=torch.long),
+            }
+        )
+        dp_size = self._get_dp_size(self.actor_rollout_wg, "actor")
+        score_batch, pad_size = pad_dataproto_to_divisor(score_batch, dp_size)
+        scored = self._compute_actor_target_log_prob(score_batch)
+        if pad_size:
+            scored = unpad_dataproto(scored, pad_size)
+
+        transform = str(getattr(actor_cfg, "pred_nll_reward_transform", "neg_nll"))
+        max_nll = float(getattr(actor_cfg, "pred_nll_max", 20.0))
+        turn_scores = []
+        target_log_probs = scored.batch["target_log_probs"]
+        for row_index, ((batch_index, _turn, boundary), target_ids) in enumerate(
+            zip(row_map, targets, strict=True)
+        ):
+            target_len = len(target_ids)
+            score = prediction_log_probs_to_reward(
+                target_log_probs[row_index, :target_len],
+                torch.ones(target_len, dtype=torch.long),
+                transform=transform,
+                max_nll=max_nll,
+            )
+            dense[batch_index, boundary] += coef * score
+            turn_scores.append(score)
+
+        return dense, {
+            "reward/pred_nll_scored_turns": float(len(turn_scores)),
+            "reward/pred_nll_mean": float(sum(turn_scores) / len(turn_scores)),
+            "reward/pred_nll_candidate_turns": float(candidate_turns),
+            "reward/pred_nll_invalid_turns": float(invalid_turns),
+            "reward/pred_nll_reward_mean": float(
+                coef * sum(turn_scores) / len(turn_scores)
+            ),
+        }
+
+
+    def _scheduled_pred_sft_coef(self) -> float:
+        """pred_sft_coef for the CURRENT step, under the warmup/hold/decay schedule.
+
+        Fractions of total training steps rather than absolute steps, so the same
+        schedule means the same thing when the dataset size changes (expert-only
+        filtering halves the step count at fixed epochs).
+
+        With pred_sft_coef_final < 0 the schedule is off and the constant
+        pred_sft_coef is returned — the behaviour of every run before this.
+        """
+        actor_cfg = self.config.actor_rollout_ref.actor
+        peak = float(getattr(actor_cfg, "pred_sft_coef", 0.0) or 0.0)
+        final = float(getattr(actor_cfg, "pred_sft_coef_final", -1.0))
+        if peak <= 0 or final < 0:
+            return peak
+
+        total = int(getattr(self, "total_training_steps", 0) or 0)
+        if total <= 0:
+            return peak
+        # global_steps is 1-based inside fit(); map step 1 -> 0.0 and the final
+        # step -> exactly 1.0, so the decay actually lands on pred_sft_coef_final.
+        frac = max(0.0, min(1.0, (int(getattr(self, "global_steps", 1)) - 1) / max(1, total - 1)))
+
+        warm = float(getattr(actor_cfg, "pred_sft_coef_warmup_frac", 0.0) or 0.0)
+        dstart = float(getattr(actor_cfg, "pred_sft_coef_decay_start_frac", 1.0))
+        warm = max(0.0, min(1.0, warm))
+        dstart = max(warm, min(1.0, dstart))
+
+        if frac < warm:
+            # Ramp from a small floor rather than 0 so the aux columns are still
+            # built on step 1 (coef <= 0 would skip them and hide the loss metric).
+            return peak * max(1e-3, frac / warm) if warm > 0 else peak
+        if frac < dstart:
+            return peak
+        if dstart >= 1.0:
+            return peak
+        t = (frac - dstart) / (1.0 - dstart)
+        return peak + (final - peak) * t
+
+    def _push_pred_sft_coef(self) -> float:
+        """Send the scheduled coefficient to the actor workers when it changes.
+
+        The worker binds aux_coef once at setup, so without this the schedule
+        would change only the trainer-side gate and not the actual loss weight.
+        """
+        coef = self._scheduled_pred_sft_coef()
+        peak = float(getattr(self.config.actor_rollout_ref.actor, "pred_sft_coef", 0.0) or 0.0)
+        final = float(getattr(self.config.actor_rollout_ref.actor, "pred_sft_coef_final", -1.0))
+        if peak <= 0 or final < 0:
+            return coef  # schedule disabled; worker already holds the constant
+        prev = getattr(self, "_last_pushed_aux_coef", None)
+        if prev is None or abs(prev - coef) > 1e-9:
+            # NOT telemetry: this IS the loss weight. A failed push leaves the
+            # worker on the static config value while actor/pred_sft_coef keeps
+            # logging the schedule, so the run looks correct and is not (see
+            # 904892, which trained at a flat 0.1 for all 180 steps). Die instead.
+            try:
+                self.actor_rollout_wg.set_aux_coef(coef)
+            except Exception as exc:
+                raise RuntimeError(
+                    "[pred_sft] could not push the scheduled aux coefficient to the "
+                    f"actor workers ({exc!r}). The applied weight would silently stay "
+                    "at the static actor.pred_sft_coef while actor/pred_sft_coef logs "
+                    "the schedule. Refusing to train a run that misreports its own "
+                    "objective; disable the schedule with pred_sft_coef_final<0 to run "
+                    "at a constant coefficient on purpose."
+                ) from exc
+            self._last_pushed_aux_coef = coef
+        return coef
+
+    def _build_pred_sft_columns(self, batch: DataProto, batch_td):
+        """CToM:  attach per-row "predict-next-user-turn" SFT sequences
+        as nested-tensor columns (sft_input_ids / sft_position_ids /
+        sft_loss_mask) on the no-padding actor batch. Row-aligned 1:1 with the
+        PPO rows so they ride through mini-batching and land in the same step.
+
+        Rows without a usable (assistant, next-user) pair get a 1-token
+        placeholder with an all-zero loss mask (no gradient contribution).
+        Columns are only attached when at least one row has real targets.
+        """
+        coef = self._scheduled_pred_sft_coef()
+        if coef <= 0:
+            return batch_td
+
+        # sft_v2 swaps the sequence builder: per-turn on-policy-context rows
+        # instead of one teacher-forced sequence per conversation.
+        if self._ctom_prediction_mode() == "sft_v2":
+            return self._build_pred_sft_v2_columns(batch, batch_td, coef)
+        # sft_v4/v5 share sft_v3's snapshot contract (see _compute_prediction_nll_reward).
+        # v5 differs only in the TARGET, injected via targets_override below.
+        if self._ctom_prediction_mode() in ("sft_v3", "sft_v4", "sft_v5", "sft_v7"):
+            return self._build_pred_sft_v3_columns(batch, batch_td, coef)
+
+        from ctom.prediction_loss import build_prediction_sft_sequence
+
+        # The rollout's per-sample conversation is flattened into the main batch's
+        # non_tensor_batch under "messages" (extra_fields key) — value is
+        # {"messages": <list-of-conversations>}. (The reward path wraps the same
+        # data under "tool_extra_fields"; fall back to it just in case.)
+        msgs_col = batch.non_tensor_batch.get("messages", None)
+        tef_col = batch.non_tensor_batch.get("tool_extra_fields", None)
+        if msgs_col is None and tef_col is None:
+            print(
+                "[pred_sft] WARNING: no 'messages'/'tool_extra_fields' in batch; "
+                f"skipping aux SFT loss this step. non_tensor keys={list(batch.non_tensor_batch.keys())}"
+            )
+            return batch_td
+
+        def _conv_for_row(i):
+            if msgs_col is not None:
+                holder = msgs_col[i]
+            else:
+                holder = tef_col[i].get("messages", {})
+            conv = holder.get("messages", []) if isinstance(holder, dict) else (holder or [])
+            if len(conv) == 1 and isinstance(conv[0], list):
+                conv = conv[0]
+            return conv
+
+        n = batch_td.batch_size[0]
+        max_seq_len = tu.get_non_tensor_data(data=batch_td, key="max_seq_len", default=None)
+        pad_id = self.tokenizer.pad_token_id
+        if pad_id is None:
+            pad_id = self.tokenizer.eos_token_id or 0
+
+        # Must match the parquet's baked-in system prompt, or the aux loss
+        # teacher-forces a format the rollout prompt never asked for.
+        pred_sft_fmt = self._ctom_pred_sft_format()
+        self._warn_pred_sft_format_mismatch(_conv_for_row(0), pred_sft_fmt)
+
+        ii, pi, lm, n_valid = [], [], [], 0
+        n_empty, n_notarget, _dumped = 0, 0, False
+        for i in range(n):
+            seq = None
+            conv = []
+            try:
+                conv = _conv_for_row(i)
+                if conv:
+                    seq = build_prediction_sft_sequence(
+                        conv, self.tokenizer, max_len=max_seq_len, fmt=pred_sft_fmt
+                    )
+            except Exception as e:  # noqa: BLE001 - fail-open per row
+                print(f"[pred_sft] row {i} build failed ({e}); using placeholder")
+                seq = None
+            # Diagnostics: characterize why rows lack SFT targets.
+            if not conv:
+                n_empty += 1
+            elif seq is None:
+                n_notarget += 1
+                if not _dumped:  # dump ONE non-empty-but-no-target conversation
+                    _dumped = True
+                    from ctom.utils import _get_role, _get_content
+                    roles = [_get_role(m) for m in conv]
+                    last = _get_content(conv[-1])[:120] if conv else ""
+                    print(f"[pred_sft][diag] row {i}: non-empty but no target. "
+                          f"len={len(conv)} roles={roles} last_content={last!r}")
+            if seq is None:
+                ii.append(torch.tensor([pad_id], dtype=torch.long))
+                pi.append(torch.tensor([0], dtype=torch.long))
+                lm.append(torch.tensor([0], dtype=torch.long))
+            else:
+                ii.append(torch.tensor(seq["input_ids"], dtype=torch.long))
+                pi.append(torch.tensor(seq["position_ids"], dtype=torch.long))
+                lm.append(torch.tensor(seq["loss_mask"], dtype=torch.long))
+                n_valid += 1
+
+        if n_valid == 0:
+            print(
+                f"[pred_sft] WARNING: no usable SFT sequences this step (rows={n}, "
+                f"empty_convs={n_empty}, nonempty_no_target={n_notarget}); skipping aux SFT loss"
+            )
+            return batch_td
+
+        batch_td["sft_input_ids"] = torch.nested.as_nested_tensor(ii, layout=torch.jagged)
+        batch_td["sft_position_ids"] = torch.nested.as_nested_tensor(pi, layout=torch.jagged)
+        batch_td["sft_loss_mask"] = torch.nested.as_nested_tensor(lm, layout=torch.jagged)
+        total_sft_tokens = int(sum(int(t.sum()) for t in lm))
+        print(
+            f"[pred_sft] attached SFT columns: rows={n}, with_targets={n_valid}, "
+            f"empty_convs={n_empty}, nonempty_no_target={n_notarget}, "
+            f"sft_loss_tokens={total_sft_tokens}, coef={coef}"
+        )
+        return batch_td
+
+    def _ctom_prediction_mode(self) -> str:
+        """Read reward_kwargs.prediction_mode the same way CToMRewardManager
+        does (reward.reward_kwargs first, reward.reward_model.reward_kwargs as
+        fallback). Defaults to "f1" when unset/unreadable."""
+        try:
+            rk = self.config.reward.get("reward_kwargs", {}) or {}
+            if not rk:
+                rk = self.config.reward.reward_model.get("reward_kwargs", {}) or {}
+            return str(rk.get("prediction_mode", "f1")).lower()
+        except Exception:  # noqa: BLE001 - config shape varies across entrypoints
+            return "f1"
+
+    def _warn_pred_sft_format_mismatch(self, conv, fmt) -> None:
+        """Loudly flag a pred_sft_format that disagrees with the parquet prompt.
+
+        This mismatch fails SILENTLY otherwise: the builder writes the assistant
+        turns itself, so its own markers are always found and no span-location
+        warning fires. The run trains, logs a plausible aux loss, and quietly
+        teaches the policy a format the rollout prompt never asked for. Checked
+        once per attach; cost is one string scan.
+        """
+        if getattr(self, "_pred_sft_fmt_checked", False):
+            return
+        self._pred_sft_fmt_checked = True
+        try:
+            from ctom.utils import _get_content, _get_role
+
+            system = next(
+                (_get_content(m) for m in (conv or []) if _get_role(m) == "system"), ""
+            )
+            if not system:
+                return
+            if "[ANTICIPATED]" in system:
+                expected = "v7"  # sft_v7 decide / draft-predict-revise protocol
+            elif "[REVISION_START]" in system:
+                expected = "revise"  # sft_v4 draft/prediction/revision protocol
+            elif "[ANSWER_START]" in system:
+                expected = "tag"
+            else:
+                expected = "json"
+            if expected != fmt:
+                print(
+                    "=" * 78 + "\n"
+                    f"[pred_sft] FORMAT MISMATCH: parquet system prompt looks like "
+                    f"'{expected}' but reward_kwargs.pred_sft_format='{fmt}'.\n"
+                    f"[pred_sft] The auxiliary loss will teacher-force '{fmt}' while the "
+                    f"rollout prompt asks for '{expected}' — these fight each other.\n"
+                    f"[pred_sft] Set reward_kwargs.pred_sft_format={expected} and restart.\n"
+                    + "=" * 78
+                )
+            else:
+                print(f"[pred_sft] format check OK: prompt and pred_sft_format agree ('{fmt}')")
+        except Exception as e:  # noqa: BLE001 - diagnostic must never break training
+            print(f"[pred_sft] format check skipped ({e})")
+
+    def _ctom_pred_sft_format(self) -> str:
+        """Output format the pred_sft auxiliary loss should teacher-force.
+
+        MUST match the system prompt baked into the RL parquet: "json" for
+        build_math.SYSTEM_PROMPT, "tag" for TAG_SYSTEM_PROMPT. Defaults to
+        "json" so every pre-2026-07-20 run keeps its exact behaviour.
+        """
+        try:
+            rk = self.config.reward.get("reward_kwargs", {}) or {}
+            if not rk:
+                rk = self.config.reward.reward_model.get("reward_kwargs", {}) or {}
+            return str(rk.get("pred_sft_format", "json")).lower()
+        except Exception:  # noqa: BLE001 - config shape varies across entrypoints
+            return "json"
+
+    def _build_pred_sft_v2_columns(self, batch: DataProto, batch_td, coef: float):
+        """sft_v2 mode: per-turn ON-POLICY-context SFT rows.
+
+        For each scored assistant turn t, the context is the ACTUAL rollout
+        tokens (prompt + response) up to the start of turn t's prediction-value
+        span — sampled predictions of earlier turns included — and the target
+        is the real next user turn spliced in place of the sampled one
+        (ctom.prediction_loss.build_prediction_sft_v2_rows).
+
+        A conversation's T per-turn rows are PACKED into its single batch row
+        (flat concat + a per-row `sft_seq_lens` column), preserving the 1:1 row
+        alignment the mini-batch split / DP dispatch machinery relies on. The
+        actor worker unpacks them into separate aux rows right before the
+        forward (see engine_workers._build_sft_td).
+        """
+        from ctom.prediction_loss import build_prediction_sft_v2_rows
+
+        msgs_col = batch.non_tensor_batch.get("messages", None)
+        tef_col = batch.non_tensor_batch.get("tool_extra_fields", None)
+        spans_col = batch.non_tensor_batch.get("pred_value_spans", None)
+        if (msgs_col is None and tef_col is None) or (spans_col is None and tef_col is None):
+            print(
+                "[pred_sft_v2] WARNING: missing 'messages'/'pred_value_spans' in batch; "
+                f"skipping aux SFT loss this step. non_tensor keys={list(batch.non_tensor_batch.keys())}"
+            )
+            return batch_td
+
+        def _conv_for_row(i):
+            if msgs_col is not None:
+                holder = msgs_col[i]
+            else:
+                holder = tef_col[i].get("messages", {})
+            conv = holder.get("messages", []) if isinstance(holder, dict) else (holder or [])
+            if len(conv) == 1 and isinstance(conv[0], list):
+                conv = conv[0]
+            return conv
+
+        def _spans_for_row(i):
+            # Stored FLAT (list of [start, end) pairs) — never unwrap: a
+            # single-turn row is [[s, e]], which unwrapping would corrupt.
+            sp = spans_col[i] if spans_col is not None else tef_col[i].get("pred_value_spans", [])
+            return list(sp) if sp is not None else []
+
+        n = batch_td.batch_size[0]
+        max_seq_len = tu.get_non_tensor_data(data=batch_td, key="max_seq_len", default=None)
+        pad_id = self.tokenizer.pad_token_id
+        if pad_id is None:
+            pad_id = self.tokenizer.eos_token_id or 0
+
+        prompts = batch.batch["prompts"]
+        responses = batch.batch["responses"]
+        attn = batch.batch["attention_mask"]
+        prompt_len = prompts.shape[-1]
+
+        ii, pi, lm, sl = [], [], [], []
+        n_convs_with_rows, n_rows_total, total_sft_tokens = 0, 0, 0
+        n_empty, n_norows = 0, 0
+        for i in range(n):
+            rows = []
+            try:
+                conv = _conv_for_row(i)
+                spans = _spans_for_row(i)
+                if not conv or not spans:
+                    n_empty += 1
+                else:
+                    prompt_valid = prompts[i][attn[i, :prompt_len].bool()].tolist()
+                    resp_valid_len = int(attn[i, prompt_len:].sum().item())
+                    resp_valid = responses[i][:resp_valid_len].tolist()
+                    rows = build_prediction_sft_v2_rows(
+                        prompt_valid, resp_valid, spans, conv,
+                        self.tokenizer, max_len=max_seq_len,
+                    )
+                    if not rows:
+                        n_norows += 1
+            except Exception as e:  # noqa: BLE001 - fail-open per row
+                print(f"[pred_sft_v2] row {i} build failed ({e}); using placeholder")
+                rows = []
+            if not rows:
+                ii.append(torch.tensor([pad_id], dtype=torch.long))
+                pi.append(torch.tensor([0], dtype=torch.long))
+                lm.append(torch.tensor([0], dtype=torch.long))
+                sl.append(torch.tensor([1], dtype=torch.long))
+            else:
+                flat_ii, flat_pi, flat_lm, lens = [], [], [], []
+                for r in rows:
+                    flat_ii.extend(r["input_ids"])
+                    flat_pi.extend(r["position_ids"])
+                    flat_lm.extend(r["loss_mask"])
+                    lens.append(len(r["input_ids"]))
+                ii.append(torch.tensor(flat_ii, dtype=torch.long))
+                pi.append(torch.tensor(flat_pi, dtype=torch.long))
+                lm.append(torch.tensor(flat_lm, dtype=torch.long))
