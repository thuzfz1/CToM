+"""Sparse legal-action probabilities for CToM's single-token controller.
+
+An action row contains [draft_id, ask_id, commit_id]; -1 masks an illegal
+choice, and [-1, -1, -1] identifies ordinary language tokens. Logits supplied
+here have already been divided by the policy sampling temperature.
+"""
+
+import torch
+
+
+def categorical_outputs(logits, labels, allowed_ids, language_log_probs):
+    positions = (allowed_ids >= 0).any(-1).nonzero(as_tuple=True)[0]
+    ids = allowed_ids[positions]
+    legal = ids >= 0
+    # Advanced indexing only materializes the two/three action logits, never
+    # a second full vocabulary tensor.
+    selected = logits[positions[:, None], ids.clamp_min(0)].float()
+    selected = selected.masked_fill(~legal, -torch.inf)
+    log_q = selected.log_softmax(-1)
+    q = log_q.exp()
+    matches = ids.eq(labels[positions, None]) & legal
+    if not matches.sum(-1).eq(1).all():
+        raise ValueError("Sampled action is not in its recorded legal action set")
+    action_log_probs = log_q.masked_fill(~matches, 0).sum(-1)
+    entropy = -(q * log_q.masked_fill(~legal, 0)).sum(-1)
+    # index_copy removes the full-vocabulary gradient at action positions.
+    log_probs = language_log_probs.index_copy(0, positions, action_log_probs)
+    zeros = torch.zeros_like(language_log_probs)
+    outputs = {
+        "action_entropy": zeros.index_copy(0, positions, entropy),
+        "action_p_ask": zeros.index_copy(0, positions, q[:, 1]),
+        "action_p_draft": zeros.index_copy(0, positions, q[:, 0]),
+        "action_p_commit": zeros.index_copy(0, positions, q[:, 2]),
+    }
+    return log_probs, outputs
+
+
+def shifted_action_ids(action_ids, attention_mask):
+    """Response-token metadata -> unpadded causal logit positions, row by row."""
+    prompt_width = attention_mask.shape[1] - action_ids.shape[1]
+    rows = []
+    for ids, mask in zip(action_ids, attention_mask, strict=True):
+        full = torch.cat((ids.new_full((prompt_width, 3), -1), ids))
+        full = full[mask.bool()]
+        rows.append(torch.cat((full[1:], full.new_full((1, 3), -1))))
+    return torch.nested.as_nested_tensor(rows, layout=torch.jagged)
+
+
+def episode_action_mean(values, mask, *, global_batch_size, dp_size):
+    """Mean decisions within episode, then mean over the global PPO batch.
+
+    Episodes without decisions contribute zero; controller/language length and
+    microbatch partitioning cannot change the regularizer's coefficient.
+    """
+    per_episode = (values * mask).sum(-1) / mask.sum(-1).clamp_min(1)
+    return per_episode.sum() * dp_size / global_batch_size
+
+
+def action_batch_from_records(records, response_ids, response_mask):
+    """Validate rollout offsets and materialize response-aligned action metadata."""
+    result = response_ids.new_full((*response_ids.shape, 3), -1)
+    for i, rounds in enumerate(records):
+        seen = set()
+        for record in rounds or []:
+            if record.get("action_protocol") != "categorical_v1":
+                raise ValueError("Mixed/missing action protocols in categorical rollout batch")
+            offset = record.get("action_offset")
+            ids = record.get("action_token_ids", [])
+            if (not isinstance(offset, int) or not 0 <= offset < response_ids.shape[1]
+                    or offset in seen or len(ids) != 3):
+                raise ValueError("Invalid/duplicate categorical action offset or alphabet")
+            if not response_mask[i, offset] or int(response_ids[i, offset]) not in ids:
+                raise ValueError("Action metadata does not match the sampled PPO token")
+            seen.add(offset)
+            result[i, offset] = result.new_tensor(ids)
+    return result
